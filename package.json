{
  "name": "life-circle-web",
  "version": "0.2.0",
  "description": "基于百度地图开放能力的“15分钟生活圈”智能体检与规划助手（React + Ant Design 前端）",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs --log-level=warning",
    "start": "node --env-file-if-exists=.env dist-server/index.cjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "docker:build": "docker build -t life-circle-web .",
    "docker:run": "docker run --rm -p 8787:8787 --env-file .env life-circle-web"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "antd": "^5.26.2",
    "echarts": "^5.6.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  }
}
